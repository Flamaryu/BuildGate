# Copy these values into local.properties (or export as environment variables)
# once you create your Hosted Supabase project at https://supabase.com/dashboard
# When left blank, BuildGate runs automatically in reactive Offline Demo Mode.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
