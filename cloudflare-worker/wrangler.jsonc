{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildgate-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "../webApp/build/dist/wasmJs/productionExecutable",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "routes": [
    { "pattern": "buildgatehub.com", "custom_domain": true },
    { "pattern": "www.buildgatehub.com", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://lrqwkdqheumyigrpqevw.supabase.co",
    "PUBLIC_ORIGIN": "https://buildgatehub.com"
  }
  // Uncomment after enabling R2 in Cloudflare Dashboard and creating bucket "buildgate-media":
  // ,"r2_buckets": [
  //   { "binding": "MEDIA_BUCKET", "bucket_name": "buildgate-media" }
  // ]
}
